<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" style="-fx-background-color: white; -fx-background-radius: 15;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gov.iti.jets.controller.AnnouncementController">
    <effect>
        <DropShadow color="#00000022" radius="10" spread="0.1" />
    </effect>
    <padding>
        <Insets bottom="30" left="30" right="30" top="20" />
    </padding>

    <top>
        <VBox alignment="CENTER" spacing="10">
           <children>
               <Label style="-fx-text-fill: #13547a;" text="New Announcement">
                   <font>
                       <Font name="System Bold" size="28.0" />
                   </font>
               </Label>
               <Label style="-fx-text-fill: #7f8c8d;" text="Create and send announcements to your team">
                   <font>
                       <Font size="14.0" />
                   </font>
               </Label>
           </children>
        </VBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20" top="30" />
            </padding>
            <children>
                <VBox spacing="8">
                   <children>
                       <Label style="-fx-text-fill: #13547a;" text="Title">
                           <font>
                               <Font name="System Bold" size="14.0" />
                           </font>
                       </Label>
                       <TextField fx:id="announcementTitle" prefWidth="400" promptText="Enter announcement title" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-background-color: #f8f9fa;">
                           <padding>
                               <Insets bottom="12" left="15" right="15" top="12" />
                           </padding>
                       </TextField>
                   </children>
                </VBox>

                <VBox spacing="8">
   <children>
                       <Label style="-fx-text-fill: #13547a;" text="Message">
                           <font>
                               <Font name="System Bold" size="14.0" />
                           </font>
                       </Label>
                       <TextArea fx:id="announcementContent" prefHeight="150" prefWidth="400" promptText="Write your announcement message here" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-background-color: #f8f9fa;" wrapText="true">
                           <padding>
                               <Insets bottom="12" left="15" right="15" top="12" />
                           </padding>
                       </TextArea>
   </children>
                </VBox>
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
           <children>
               <Button mnemonicParsing="false" onAction="#handleSendAnnouncement" prefHeight="50.0" prefWidth="160.0" style="-fx-background-color: #71b9b1; -fx-background-radius: 25; -fx-cursor: hand; -fx-text-fill: white;" text="Send" textFill="WHITE">
                   <font>
                       <Font name="System Bold" size="16.0" />
                   </font>
                   <effect>
                       <DropShadow color="#00000033" radius="10" spread="0.1" />
                   </effect>
               </Button>
           </children>
        </HBox>
    </bottom>
</BorderPane>
